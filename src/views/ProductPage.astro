---
import BaseLayout from '../layouts/BaseLayout.astro';
import Topo from '../components/Topo.astro';
import StatusPill from '../components/StatusPill.astro';
import type { Product } from '../config/products.config';
import { site } from '../config/site.config';
import { t, href, type Lang } from '../i18n';
interface Props { lang: Lang; product: Product }
const { lang, product: p } = Astro.props;
const dict = t(lang);
const d = dict.products;
const c = p[lang];
const siteUrl = (Astro.site?.href ?? '').replace(/\/$/, '');
const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: p.name,
  description: c.description,
  applicationCategory: c.sector,
  operatingSystem: 'Android, iOS, Web',
  url: p.url ?? siteUrl + href(lang, 'product', p.slug),
  publisher: { '@type': 'Organization', name: site.name },
};
const crumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: site.name, item: siteUrl + href(lang, 'home') },
    { '@type': 'ListItem', position: 2, name: d.eyebrow, item: siteUrl + href(lang, 'home', undefined, dict.anchors.products) },
    { '@type': 'ListItem', position: 3, name: p.name, item: siteUrl + href(lang, 'product', p.slug) },
  ],
};
---
<BaseLayout lang={lang} route="product" slug={p.slug} title={p.name} description={`${p.name}: ${c.tagline} ${c.description}`.slice(0, 158)} og={`product-${p.slug}-${lang}`} jsonLd={[ld, crumbs]} headerTone="dark">
  <section class="phero" data-tone="dark" style={`--p-accent:${p.accent}`}>
    <div class="phero-map" aria-hidden="true"><Topo seed={p.slug} levels={20} peaks={3} class="phero-topo" /></div>
    <div class="container phero-in">
      <a class="back mono" href={href(lang, 'home', undefined, dict.anchors.products)}>← {d.back}</a>
      <StatusPill status={p.status} lang={lang} />
      <p class="eyebrow">{c.sector} · {lang === 'es' ? 'por Ápice' : 'by Ápice'}</p>
      <h1>{p.name}</h1>
      <p class="tag">{c.tagline}</p>
    </div>
  </section>
  <section class="section pbody">
    <div class="container cols">
      <div class="desc">
        <p class="lead">{c.description}</p>
        {p.partners?.length ? <p class="partners mono">{d.partnersLabel}: {p.partners.join(' · ')}</p> : null}
        <div class="actions">
          {p.url && p.status === 'available'
            ? <a class="btn" href={p.url} target="_blank" rel="noopener">{d.visit} <span class="arrow" aria-hidden="true">↗</span></a>
            : <a class="btn" href={href(lang, 'home', undefined, dict.anchors.contact)}>{d.notifyCta} <span class="arrow" aria-hidden="true">→</span></a>}
        </div>
      </div>
      <div class="feats">
        <p class="eyebrow">{d.featuresLabel}</p>
        <ol>
          {c.features.map((f, i) => (
            <li data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span class="mono n">{String(i + 1).padStart(2, '0')}</span>
              <div><h2>{f.title}</h2><p>{f.text}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .phero { position: relative; background: var(--c-night); color: #EEF1F0; padding-block: calc(9rem + env(safe-area-inset-top, 0px)) clamp(4rem, 3rem + 4vw, 7rem); overflow: hidden; isolation: isolate; }
  .phero-map { position: absolute; right: -8%; top: 50%; width: min(820px, 90vw); transform: translateY(-50%); color: var(--p-accent); opacity: 0.55; z-index: -1; }
  .phero-map :global(.phero-topo path) { stroke-dasharray: 1400; stroke-dashoffset: 1400; animation: ph-draw 3.5s var(--ease-out) forwards; animation-delay: calc(var(--l) * 60ms); }
  @keyframes ph-draw { to { stroke-dashoffset: 0; } }
  .phero-in { display: grid; gap: var(--space-5); justify-items: start; }
  .phero .eyebrow { color: var(--c-glacier-light); }
  .phero h1 { font-size: var(--text-4xl); line-height: 0.95; }
  .tag { font: 380 var(--text-xl)/1.3 var(--font-display); font-style: italic; color: #f3dca8; max-width: 30ch; }
  .back { font-size: var(--text-xs); color: #A9B6BD; text-decoration: none; letter-spacing: 0.08em; }
  .back:hover { color: #fff; }
  .phero :global(.pill) { background: transparent; color: #EEF1F0; border-color: #26394A; }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: var(--space-9); }
  .desc { display: grid; gap: var(--space-5); align-content: start; }
  .partners { font-size: var(--text-xs); color: var(--muted); }
  .actions { margin-top: var(--space-3); }
  .feats { display: grid; gap: var(--space-5); }
  .feats ol { list-style: none; display: grid; }
  .feats li { display: grid; grid-template-columns: 3rem 1fr; gap: var(--space-4); padding-block: var(--space-5); border-top: 1px solid var(--line); }
  .feats .n { font-size: var(--text-xs); color: var(--gold-text); padding-top: 0.4rem; }
  .feats h2 { font-size: var(--text-xl); margin-bottom: var(--space-2); }
  .feats p { color: var(--muted); }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr; gap: var(--space-7); } .phero-map { opacity: 0.3; right: -30%; } }
</style>
