---
import BaseLayout from '../layouts/BaseLayout.astro';
import { legal } from '../i18n/legal';
import { site, isPending } from '../config/site.config';
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; doc: 'privacy' | 'cookies' }
const { lang, doc } = Astro.props;
const L = legal[lang][doc];
const email = isPending(site.contactEmail) ? t(lang).contact.pendingEmail.toLowerCase() : site.contactEmail;
const fill = (s: string) => s.replaceAll('{name}', site.legalName).replaceAll('{email}', email);
const LAST_UPDATED = '2026-10-26';
const date = new Date(LAST_UPDATED + 'T12:00:00Z').toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout lang={lang} route={doc} title={L.title} description={fill(L.intro).slice(0, 158)}>
  <article class="legal section">
    <div class="container inner">
      <header>
        <p class="eyebrow">Legal</p>
        <h1>{L.title}</h1>
        <p class="lead">{fill(L.intro)}</p>
        <p class="upd mono">{L.updated}: <time datetime={LAST_UPDATED}>{date}</time></p>
      </header>
      <div class="body">
        {L.sections.map((s) => (
          <section>
            <h2>{s.h}</h2>
            {s.p.map((p) => <p>{fill(p)}</p>)}
          </section>
        ))}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal { padding-top: calc(9rem + env(safe-area-inset-top, 0px)); }
  .inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: var(--space-9); }
  header { display: grid; gap: var(--space-5); align-content: start; position: sticky; top: 7rem; }
  h1 { font-size: var(--text-3xl); }
  .upd { font-size: var(--text-xs); color: var(--muted); }
  .body { display: grid; gap: var(--space-7); max-width: var(--text-width); }
  .body section { display: grid; gap: var(--space-3); padding-top: var(--space-5); border-top: 1px solid var(--line); }
  .body h2 { font-size: var(--text-xl); }
  .body p { color: var(--muted); }
  @media (max-width: 900px) { .inner { grid-template-columns: 1fr; gap: var(--space-7); } header { position: static; } }
</style>
