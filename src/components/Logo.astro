---
/**
 * Logo de Ápice en SVG en línea. Hereda el color del texto (currentColor);
 * el rombo de la cima siempre es dorado salvo en la versión monocroma.
 *
 * Props:
 *  - variant: 'horizontal' (isotipo + logotipo) | 'isotipo' | 'logotipo'
 *  - animated: dibuja las crestas y deja caer la cima al cargar
 *  - mono: sin dorado
 */
import data from '../brand/logo-data.json';

interface Props {
  variant?: 'horizontal' | 'isotipo' | 'logotipo';
  animated?: boolean;
  mono?: boolean;
  class?: string;
  title?: string;
}
const { variant = 'horizontal', animated = false, mono = false, class: cls = '', title = 'Ápice' } = Astro.props;
const gold = mono ? 'currentColor' : 'var(--c-dawn)';
const s = (data.asc + 6) / 64;
const gap = 26;
const isoW = 64 * s;
const W = isoW + gap + data.wmWidth;
const H = data.asc + data.desc;
---
{variant === 'isotipo' && (
  <svg class:list={['logo', 'logo--iso', { 'logo--anim': animated }, cls]} viewBox="0 0 64 64" role="img" aria-label={title}>
    <circle class="logo-glow" cx="27" cy="5.6" r="9" fill={gold} />
    {data.ridges.map((r, i) => (
      <path class={`logo-ridge logo-ridge-${i + 1}`} d={r.d} fill="none" stroke="currentColor" stroke-width={r.w} stroke-linecap="round" stroke-linejoin="round" pathLength="100" />
    ))}
    <path class="logo-apex" d={data.apex} fill={gold} />
  </svg>
)}
{variant === 'horizontal' && (
  <svg class:list={['logo', 'logo--h', { 'logo--anim': animated }, cls]} viewBox={`-2 -8 ${(W + 4).toFixed(1)} ${(H + 12).toFixed(1)}`} role="img" aria-label={title}>
    <g transform={`translate(0 -6) scale(${s.toFixed(4)})`}>
      <circle class="logo-glow" cx="27" cy="5.6" r="9" fill={gold} />
      {data.ridges.map((r, i) => (
        <path class={`logo-ridge logo-ridge-${i + 1}`} d={r.d} fill="none" stroke="currentColor" stroke-width={r.w} stroke-linecap="round" stroke-linejoin="round" pathLength="100" />
      ))}
      <path class="logo-apex" d={data.apex} fill={gold} />
    </g>
    <g transform={`translate(${(isoW + gap).toFixed(2)} ${data.asc.toFixed(2)})`}>
      <path class="logo-word" d={data.wordmark} fill="currentColor" />
      <path class="logo-accent" d={data.accent} fill={gold} />
    </g>
  </svg>
)}
{variant === 'logotipo' && (
  <svg class:list={['logo', 'logo--w', { 'logo--anim': animated }, cls]} viewBox={`-2 -2 ${(data.wmWidth + 4).toFixed(1)} ${(H + 4).toFixed(1)}`} role="img" aria-label={title}>
    <g transform={`translate(0 ${data.asc})`}>
      <path class="logo-word" d={data.wordmark} fill="currentColor" />
      <path class="logo-accent" d={data.accent} fill={gold} />
    </g>
  </svg>
)}

<style is:global>
  .logo { height: auto; overflow: visible; }
  .logo-glow { opacity: 0; transform-box: fill-box; transform-origin: center; pointer-events: none; }
  .logo-apex, .logo-accent { transform-box: fill-box; transform-origin: center; }
  .logo--anim .logo-ridge { stroke-dasharray: 100; stroke-dashoffset: 100; animation: logo-draw 1.5s var(--ease-in-out) forwards; }
  .logo--anim .logo-ridge-2 { animation-delay: 0.16s; }
  .logo--anim .logo-ridge-3 { animation-delay: 0.32s; }
  .logo--anim .logo-apex { opacity: 0; transform: translateY(-60%) rotate(-135deg) scale(0.2); animation: logo-drop 0.9s var(--ease-out) 1.05s forwards; }
  .logo--anim .logo-word { opacity: 0; animation: logo-word 1.1s var(--ease-out) 0.5s forwards; }
  .logo--anim .logo-accent { opacity: 0; transform: scale(0) rotate(-90deg); animation: logo-drop 0.7s var(--ease-out) 1.4s forwards; }
  .logo--anim .logo-glow { animation: logo-glow 2.2s ease-out 1.6s; }
  /* Al pasar el cursor: las crestas se vuelven a trazar y la cima destella */
  a:hover > .logo .logo-ridge, .logo:hover .logo-ridge { animation: logo-redraw 1.1s var(--ease-in-out); }
  a:hover > .logo .logo-ridge-2, .logo:hover .logo-ridge-2 { animation-delay: 0.08s; }
  a:hover > .logo .logo-ridge-3, .logo:hover .logo-ridge-3 { animation-delay: 0.16s; }
  a:hover > .logo .logo-glow, .logo:hover .logo-glow { animation: logo-glow 1.6s ease-out; }
  @keyframes logo-draw { to { stroke-dashoffset: 0; } }
  @keyframes logo-redraw { 0% { stroke-dasharray: 100; stroke-dashoffset: 0; } 45% { stroke-dashoffset: -100; } 46% { stroke-dashoffset: 100; } 100% { stroke-dasharray: 100; stroke-dashoffset: 0; } }
  @keyframes logo-drop { to { opacity: 1; transform: none; } }
  @keyframes logo-word { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: none; } }
  @keyframes logo-glow { 0% { opacity: 0.8; transform: scale(0.3); } 100% { opacity: 0; transform: scale(3); } }
  @media (prefers-reduced-motion: reduce) {
    .logo--anim .logo-ridge, .logo--anim .logo-apex, .logo--anim .logo-word, .logo--anim .logo-accent { animation: none; stroke-dashoffset: 0; opacity: 1; transform: none; }
    .logo .logo-ridge, .logo .logo-glow { animation: none !important; }
  }
</style>
