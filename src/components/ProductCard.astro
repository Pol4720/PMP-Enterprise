---
import Topo from './Topo.astro';
import StatusPill from './StatusPill.astro';
import type { Product } from '../config/products.config';
import { t, href, type Lang } from '../i18n';
interface Props { product: Product; lang: Lang; index: number }
const { product: p, lang, index } = Astro.props;
const d = t(lang).products;
const c = p[lang];
---
<article class="pcard" style={`--p-accent:${p.accent}`} data-reveal>
  <a class="pcard-link" href={href(lang, 'product', p.slug)} aria-label={`${p.name} · ${d.details}`}></a>
  <div class="pcard-map" aria-hidden="true">
    <Topo seed={p.slug} levels={14} peaks={3} class="pcard-topo" />
    <span class="pcard-coord mono">N{(index + 1).toString().padStart(2, '0')} · {c.sector}</span>
  </div>
  <div class="pcard-body">
    <div class="pcard-meta">
      <StatusPill status={p.status} lang={lang} />
    </div>
    <h3>{p.name}</h3>
    <p class="pcard-tag">{c.tagline}</p>
    <p class="pcard-desc">{c.description}</p>
    {p.partners?.length ? <p class="pcard-partners mono">{d.partnersLabel}: {p.partners.join(' · ')}</p> : null}
    <div class="pcard-actions">
      <span class="more">{d.details} <span aria-hidden="true">→</span></span>
      {p.url && p.status === 'available' && <a class="ext" href={p.url} target="_blank" rel="noopener">{d.visit} ↗</a>}
    </div>
  </div>
</article>

<style>
  .pcard { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); background: var(--surface); border: 1px solid var(--line); overflow: hidden; transition: border-color var(--dur-slow) var(--ease-out), transform var(--dur-slow) var(--ease-out); }
  .pcard:hover { border-color: var(--p-accent); }
  .pcard-link { position: absolute; inset: 0; z-index: 2; }
  .pcard-link:focus-visible { outline-offset: -4px; }
  .pcard-map { position: relative; background: var(--c-night); color: var(--p-accent); padding: var(--space-6); display: grid; place-items: center; min-height: 320px; --topo-summit: var(--c-dawn); }
  .pcard-map :global(.pcard-topo) { width: 100%; max-width: 300px; transition: transform 1.6s var(--ease-out); }
  .pcard:hover .pcard-map :global(.pcard-topo) { transform: scale(1.06) rotate(-3deg); }
  .pcard-coord { position: absolute; left: var(--space-5); bottom: var(--space-4); font-size: 0.7rem; color: #A9B6BD; letter-spacing: 0.08em; text-transform: uppercase; }
  .pcard-body { padding: clamp(1.5rem, 1rem + 2vw, 3rem); display: grid; gap: var(--space-4); align-content: start; }
  .pcard h3 { font-size: var(--text-2xl); }
  .pcard-tag { font: 400 var(--text-lg)/1.3 var(--font-display); font-style: italic; color: var(--fg); }
  .pcard-desc { color: var(--muted); font-size: var(--text-sm); max-width: 52ch; }
  .pcard-partners { font-size: var(--text-xs); color: var(--muted); }
  .pcard-actions { display: flex; gap: var(--space-5); align-items: center; margin-top: var(--space-3); }
  .more { font-weight: 500; font-size: var(--text-sm); border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  .ext { position: relative; z-index: 3; font-size: var(--text-sm); }
  @media (max-width: 820px) { .pcard { grid-template-columns: 1fr; } .pcard-map { min-height: 240px; } }
</style>
