---
import ProductPage from '../../views/ProductPage.astro';
import { visibleProducts, type Product } from '../../config/products.config';
export function getStaticPaths() {
  return visibleProducts.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props as { product: Product };
---
<ProductPage lang="es" product={product} />
