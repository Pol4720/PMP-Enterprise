---
/**
 * Brand Guidelines de Ápice. Lee los tokens (src/design/tokens.ts) y los logos generados,
 * así que siempre refleja el sistema real del sitio.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';
import Icon from '../../components/Icon.astro';
import Topo from '../../components/Topo.astro';
import { palette, contrast, typography, motion } from '../../design/tokens';
import { asset } from '../../i18n';
import { es } from '../../i18n/es';

const nav = [
  ['esencia', 'Esencia'], ['arquitectura', 'Arquitectura'], ['tono', 'Tono de voz'], ['logo', 'Logo'],
  ['color', 'Color'], ['tipografia', 'Tipografía'], ['iconos', 'Iconografía'], ['ilustracion', 'Ilustración'],
  ['fotografia', 'Fotografía'], ['movimiento', 'Movimiento'], ['aplicaciones', 'Aplicaciones'], ['descargas', 'Descargas'],
];
const b = (p: string) => asset(`brand/${p}`);
const logoVariants = [
  { name: 'Horizontal', file: 'apice-horizontal', bg: 'light', v: 'horizontal' as const },
  { name: 'Horizontal · oscuro', file: 'apice-horizontal-oscuro', bg: 'dark', v: 'horizontal' as const },
  { name: 'Vertical', file: 'apice-vertical', bg: 'light', v: 'vertical' as const },
  { name: 'Isotipo', file: 'apice-isotipo', bg: 'light', v: 'isotipo' as const },
  { name: 'Isotipo · oscuro', file: 'apice-isotipo-oscuro', bg: 'dark', v: 'isotipo' as const },
  { name: 'Logotipo', file: 'apice-logotipo', bg: 'light', v: 'logotipo' as const },
  { name: 'Monocromo negro', file: 'apice-horizontal-mono-negro', bg: 'light', v: 'horizontal' as const, mono: true },
  { name: 'Monocromo blanco', file: 'apice-horizontal-mono-blanco', bg: 'dark', v: 'horizontal' as const, mono: true },
];
const sw = Object.entries(palette);
const iconNames = ['advisory', 'statistics', 'ml', 'ai', 'analytics', 'custom', 'arrow', 'external', 'mail', 'copy', 'check', 'shield'] as const;
const fam = typography.families;
---
<BaseLayout lang="es" route="brand" title="Brand Guidelines" description="Sistema de marca de Ápice: logo, color, tipografía, iconografía, movimiento y aplicaciones." og="brand" noAlternate>
  <section class="bhero" data-tone="dark">
    <div class="bmap" aria-hidden="true"><Topo seed="apice-brand" levels={22} peaks={3} /></div>
    <div class="container bhero-in">
      <p class="eyebrow">Brand Guidelines · v1.0</p>
      <h1>Sistema de marca</h1>
      <p class="lead">Todo lo necesario para que Ápice se vea, suene y se mueva igual en cualquier lugar. Los colores, tipografías y medidas de esta página salen de los mismos tokens que usa el sitio.</p>
    </div>
  </section>

  <div class="container blayout">
    <nav class="toc" aria-label="Secciones del manual">
      <ol>{nav.map(([id, label], i) => <li><a href={`#${id}`}><span class="mono">{String(i + 1).padStart(2, '0')}</span>{label}</a></li>)}</ol>
    </nav>

    <div class="bcontent">
      <!-- 01 Esencia -->
      <section id="esencia" class="bsec">
        <p class="eyebrow">01 · Esencia</p>
        <h2>Qué es Ápice</h2>
        <div class="two">
          <div class="stack">
            <h3>Posicionamiento</h3>
            <p>Ápice es un estudio de software y ciencia de datos que trata cada producto y cada modelo como un experimento serio: con hipótesis, validación y resultados que se pueden comprobar.</p>
            <h3>Propuesta de valor</h3>
            <p class="quote">{es.about.mission}</p>
          </div>
          <div class="stack">
            <h3>Eslogan</h3>
            <p class="slogan">Rigor científico.<br /><i>Software de altura.</i></p>
            <p class="note">En inglés: «Scientific rigour. Software at its peak.»</p>
          </div>
        </div>
        <h3 class="mt">Pilares</h3>
        <ul class="pillars">{es.about.values.map((v) => <li><b>{v.title}</b><span>{v.text}</span></li>)}</ul>
        <h3 class="mt">La idea central</h3>
        <p>Los datos son un terreno. Las curvas de nivel de un mapa topográfico son una visualización de datos real; la cima es el punto más alto de una función, lo que busca un algoritmo de optimización. Nombre, ciencia y estética cuentan la misma historia: del ruido a la cima.</p>
      </section>

      <!-- 02 Arquitectura -->
      <section id="arquitectura" class="bsec">
        <p class="eyebrow">02 · Arquitectura</p>
        <h2>Marca madre que respalda</h2>
        <p>Modelo de <b>marca respaldada</b>. Cada producto conserva su nombre y su color de acento porque sirve a sectores distintos; todos comparten tipografía, retícula y la firma «por Ápice».</p>
        <div class="arch">
          <div class="arch-top"><Logo variant="horizontal" class="arch-logo" /></div>
          <div class="arch-kids">
            <div><b>Ápice Servicios</b><span>Datos, estadística e IA a medida</span></div>
            <div><b>Muévelo</b><span>por Ápice · logística</span></div>
            <div class="dash"><b>Próximos productos</b><span>una entrada en products.config.ts</span></div>
          </div>
        </div>
        <ul class="rules">
          <li>El nombre del producto va primero y en su propio color; «por Ápice» acompaña en tipografía mono, nunca más grande.</li>
          <li>Los productos en colaboración pueden mostrar el nombre de la institución socia solo con permiso escrito.</li>
          <li>Cada producto usa Newsreader e Instrument Sans y su emblema topográfico generado a partir de su nombre.</li>
        </ul>
      </section>

      <!-- 03 Tono -->
      <section id="tono" class="bsec">
        <p class="eyebrow">03 · Tono de voz</p>
        <h2>Preciso, sereno, cercano</h2>
        <p>Hablamos como una científica que explica su trabajo a alguien inteligente que no es del área: datos concretos, sin exagerar, sin jerga innecesaria. En inglés mantenemos el tono; no traducimos palabra por palabra.</p>
        <div class="dd">
          <div class="h">Decimos</div><div class="h">Evitamos</div>
          <p>Reducimos el tiempo de revisión documental de días a horas.</p><p class="no">Revolucionamos la auditoría con IA disruptiva.</p>
          <p>Validamos cada modelo con datos que no vio durante el entrenamiento.</p><p class="no">Nuestra IA de última generación nunca se equivoca.</p>
          <p>Te decimos qué podemos resolver y qué no.</p><p class="no">¡Soluciones 360° para todas tus necesidades!</p>
          <p>Análisis estadístico, modelos predictivos, aprendizaje automático.</p><p class="no">Sinergias data-driven de next level.</p>
        </div>
        <ul class="rules">
          <li>Frases cortas, voz activa, verbos concretos.</li>
          <li>Cifras con su unidad y su contexto; nunca cifras sin fuente.</li>
          <li>Tuteo en español; trato directo y respetuoso.</li>
          <li>Nombres de personas y cargos no aparecen en la web corporativa.</li>
        </ul>
      </section>

      <!-- 04 Logo -->
      <section id="logo" class="bsec">
        <p class="eyebrow">04 · Logo</p>
        <h2>Tres crestas y una cima</h2>
        <div class="two">
          <div class="logo-hero"><Logo variant="isotipo" animated class="lh" /></div>
          <div class="stack">
            <p>El isotipo son <b>tres crestas paralelas</b>: curvas de nivel de una montaña asimétrica, como las reales, que juntas forman una A. El <b>rombo dorado</b> es la cima y, a la vez, la tilde de la Á: el mismo rombo corona el logotipo.</p>
            <p>El logotipo es Newsreader Medium convertida a trazos, con «Ápice» en mayúscula inicial. Los archivos no dependen de fuentes instaladas.</p>
            <button class="btn btn--ghost replay" type="button" data-replay>Reproducir animación</button>
          </div>
        </div>

        <h3 class="mt">Variantes</h3>
        <ul class="variants">
          {logoVariants.map((l) => (
            <li>
              <div class:list={['vbox', l.bg]}><Logo variant={l.v === 'vertical' ? 'horizontal' : l.v} mono={l.mono} class={`vlogo vlogo--${l.v}`} /></div>
              <div class="vmeta">
                <b>{l.name}</b>
                <span>
                  <a href={b(`logo/${l.file}.svg`)} download>SVG</a>
                  {['apice-horizontal', 'apice-horizontal-oscuro', 'apice-vertical', 'apice-isotipo'].includes(l.file) && <a href={b(`png/${l.file}${l.file === 'apice-isotipo' ? '-1024' : '-1200'}.png`)} download>PNG</a>}
                </span>
              </div>
            </li>
          ))}
        </ul>
        <p class="note">La versión vertical se muestra aquí en horizontal por espacio; descarga el archivo para ver la composición apilada.</p>

        <div class="three mt">
          <div class="stack">
            <h3>Área de protección</h3>
            <div class="clear"><div class="clear-in"><Logo variant="horizontal" class="cl" /></div></div>
            <p class="note">Deja libre alrededor del logo, como mínimo, la altura del isotipo dividida entre dos.</p>
          </div>
          <div class="stack">
            <h3>Tamaño mínimo</h3>
            <div class="mins">
              <div><Logo variant="horizontal" class="m1" /><span class="mono">96 px · 22 mm</span></div>
              <div><Logo variant="isotipo" class="m2" /><span class="mono">16 px · 5 mm</span></div>
            </div>
            <p class="note">Por debajo de estas medidas, usa solo el isotipo o el favicon.</p>
          </div>
          <div class="stack">
            <h3>Fondos</h3>
            <div class="bgs">
              <span class="ok l"><Logo variant="isotipo" /></span><span class="ok d"><Logo variant="isotipo" /></span><span class="ok g"><Logo variant="isotipo" mono /></span>
            </div>
            <p class="note">Sobre Niebla o Noche alpina, a color. Sobre fotos o colores ajenos a la paleta, en monocromo blanco o negro.</p>
          </div>
        </div>

        <h3 class="mt">Usos incorrectos</h3>
        <ul class="misuse">
          <li><div class="mbox"><span style="display:inline-block;transform:scaleX(1.5)"><Logo variant="isotipo" /></span></div><p>No deformar</p></li>
          <li><div class="mbox"><span style="display:inline-block;transform:rotate(-20deg)"><Logo variant="isotipo" /></span></div><p>No girar</p></li>
          <li><div class="mbox"><span style="display:inline-block;color:#c0392b;filter:hue-rotate(160deg)"><Logo variant="isotipo" /></span></div><p>No cambiar colores</p></li>
          <li><div class="mbox"><span style="display:inline-block;filter:drop-shadow(4px 6px 3px rgba(0,0,0,.6))"><Logo variant="isotipo" /></span></div><p>No añadir efectos</p></li>
          <li><div class="mbox busy"><Logo variant="isotipo" /></div><p>No usar sobre fondos con ruido</p></li>
          <li><div class="mbox"><span style="display:inline-block;opacity:.35"><Logo variant="isotipo" /></span></div><p>No reducir la opacidad</p></li>
        </ul>
      </section>

      <!-- 05 Color -->
      <section id="color" class="bsec">
        <p class="eyebrow">05 · Color</p>
        <h2>Paleta «Altitud»</h2>
        <p>Fondos de baja saturación, cómodos para leer mucho tiempo; azul noche y verde glaciar para transmitir calma y seguridad; un único dorado reservado para la cima. Cuando el dorado aparece, se nota.</p>
        <div class="prop" aria-label="Proporción de uso">
          <span style="flex:58;background:var(--c-mist)">Niebla 58 %</span><span style="flex:27;background:var(--c-night);color:#EEF1F0">Noche 27 %</span><span style="flex:10;background:var(--c-glacier);color:#fff">Glaciar 10 %</span><span style="flex:5;background:var(--c-dawn)" title="Alba 5 %"></span>
        </div>
        <ul class="swatches">
          {sw.map(([, c]) => (
            <li>
              <div class="chip" style={`background:${c.hex}`}></div>
              <div class="cmeta">
                <b>{c.name}</b>
                <span class="mono">{c.hex}</span>
                <span class="mono">RGB {c.rgb}</span>
                <span class="mono">HSL {c.hsl}</span>
                <span class="role">{c.role}</span>
              </div>
            </li>
          ))}
        </ul>
        <h3 class="mt">Contraste (WCAG 2.1)</h3>
        <div class="table-wrap">
          <table class="ctable">
            <thead><tr><th>Texto</th><th>Fondo</th><th>Muestra</th><th>Ratio</th><th>Nivel</th></tr></thead>
            <tbody>
              {contrast.map((c) => (
                <tr>
                  <td>{palette[c.fg].name}</td><td>{palette[c.bg].name}</td>
                  <td><span class="sample" style={`color:${palette[c.fg].hex};background:${palette[c.bg].hex}`}>Aa Ápice</span></td>
                  <td class="mono">{c.ratio.toFixed(2)} : 1</td><td><span class="lvl">{c.level}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">AA exige 4,5 : 1 para texto normal y 3 : 1 para texto grande y gráficos. El dorado Alba no se usa para texto pequeño sobre fondos claros: para eso existe Alba profunda.</p>
      </section>

      <!-- 06 Tipografía -->
      <section id="tipografia" class="bsec">
        <p class="eyebrow">06 · Tipografía</p>
        <h2>Atlas: tres voces</h2>
        <div class="faces">
          <div class="face"><p class="fname mono">{fam.display.name} · {fam.display.role}</p><p class="spec" style={`font-family:${fam.display.stack}`}>Del ruido a la cima</p><p class="note">{fam.display.license} · Google Fonts</p></div>
          <div class="face"><p class="fname mono">{fam.sans.name} · {fam.sans.role}</p><p class="spec sans" style={`font-family:${fam.sans.stack}`}>Diseñamos modelos que se validan con datos reales y se explican con claridad.</p><p class="note">{fam.sans.license} · Google Fonts</p></div>
          <div class="face"><p class="fname mono">{fam.mono.name} · {fam.mono.role}</p><p class="spec monos" style={`font-family:${fam.mono.stack}`}>h(x, y) = 0,97 · cota 2 410 m · error 1,8 %</p><p class="note">{fam.mono.license} · Google Fonts</p></div>
        </div>
        <h3 class="mt">Escala</h3>
        <ul class="scale">
          {Object.entries(typography.scale).reverse().map(([k, v]) => (
            <li><span class="mono k">{k}</span><span class="mono v">{v}</span><span class="t" style={`font-size:${v};font-family:${['4xl', '3xl', '2xl', 'xl'].includes(k) ? fam.display.stack : fam.sans.stack}`}>Rigor científico</span></li>
          ))}
        </ul>
        <ul class="rules">
          <li>Titulares en Newsreader, peso ligero (350–400). La cursiva se reserva para la segunda frase del eslogan y las frases destacadas.</li>
          <li>Texto en Instrument Sans 400, interlineado 1,6, líneas de 60–70 caracteres.</li>
          <li>Cifras, coordenadas y etiquetas en JetBrains Mono, en mayúsculas con espaciado amplio.</li>
        </ul>
      </section>

      <!-- 07 Iconos -->
      <section id="iconos" class="bsec">
        <p class="eyebrow">07 · Iconografía</p>
        <h2>Lineales, precisos, escasos</h2>
        <ul class="icons">{iconNames.map((n) => <li><Icon name={n} size={32} /><span class="mono">{n}</span></li>)}</ul>
        <ul class="rules">
          <li>Retícula de 24 px, trazo de 1,5 px, terminaciones y uniones rectas.</li>
          <li>Siempre acompañados de texto. Un icono no sustituye a una palabra.</li>
          <li>Color de texto o Glaciar; Alba solo en el estado activo.</li>
          <li>Los iconos viven en <code>src/components/Icon.astro</code>.</li>
        </ul>
      </section>

      <!-- 08 Ilustración -->
      <section id="ilustracion" class="bsec">
        <p class="eyebrow">08 · Ilustración</p>
        <h2>Mapas generados, no dibujados</h2>
        <p>La ilustración de Ápice es topografía generada por código: cada producto, servicio o pieza tiene un emblema único que se calcula a partir de su nombre. Es imposible de copiar con un banco de imágenes y crece sola con el catálogo.</p>
        <ul class="topos">
          {['muevelo', 'asesoria', 'estadistica', 'aprendizaje-automatico'].map((s, i) => (
            <li style={`color:${i === 0 ? '#E07A3F' : 'var(--accent)'}`}><Topo seed={s} levels={14} peaks={3} /><span class="mono">seed: {s}</span></li>
          ))}
        </ul>
        <ul class="rules">
          <li>Trazo fino (0,8–1,3 px), sin rellenos; cada quinta curva, más gruesa.</li>
          <li>Un único color por emblema; el rombo dorado marca la cima.</li>
          <li>En 3D (portada) se usa la misma lógica: partículas, curvas de nivel y una ruta de ascenso.</li>
        </ul>
      </section>

      <!-- 09 Fotografía -->
      <section id="fotografia" class="bsec">
        <p class="eyebrow">09 · Fotografía</p>
        <h2>Casi nunca, y siempre con intención</h2>
        <div class="two">
          <ul class="rules">
            <li><b>Sí:</b> texturas naturales de alta montaña: roca, nieve, niebla, luz de amanecer. Encuadres abstractos, sin horizonte evidente.</li>
            <li><b>Sí:</b> tratamiento en dos tonos con Noche alpina y Niebla, o en blanco y negro con grano fino.</li>
            <li><b>Sí:</b> capturas reales de nuestros productos, en dispositivos sin marca.</li>
          </ul>
          <ul class="rules">
            <li><b>No:</b> personas posando frente a portátiles, apretones de manos, oficinas genéricas.</li>
            <li><b>No:</b> cerebros brillantes, robots, redes de nodos neón ni degradados morados.</li>
            <li><b>No:</b> fotos de los fundadores o del equipo en la web corporativa.</li>
          </ul>
        </div>
        <p class="note">Fuentes recomendadas con licencia libre: Unsplash y Pexels. Registra cada imagen en ATTRIBUTIONS.md.</p>
      </section>

      <!-- 10 Movimiento -->
      <section id="movimiento" class="bsec">
        <p class="eyebrow">10 · Movimiento</p>
        <h2>Como un ascenso, no como una explosión</h2>
        <div class="two">
          <ul class="mtokens">
            {Object.entries(motion.duration).map(([k, v]) => <li><span class="mono">--dur-{k}</span><b class="mono">{v}</b></li>)}
            {Object.entries(motion.ease).map(([k, v]) => <li><span class="mono">--ease-{k.replace(/[A-Z]/g, (m) => '-' + m.toLowerCase())}</span><b class="mono">{v}</b></li>)}
          </ul>
          <div class="motion-demo" aria-hidden="true"><i></i><i></i><i></i></div>
        </div>
        <ul class="rules">
          <li>Las cosas suben y se asientan. Nada rebota ni gira sin motivo.</li>
          <li>Un momento orquestado por pantalla; el resto, quieto.</li>
          <li>Con «reducir movimiento» activado, el contenido aparece sin animación y la historia 3D se sustituye por láminas estáticas.</li>
        </ul>
      </section>

      <!-- 11 Aplicaciones -->
      <section id="aplicaciones" class="bsec">
        <p class="eyebrow">11 · Aplicaciones</p>
        <h2>La marca en uso</h2>
        <h3>Tarjetas de presentación</h3>
        <div class="cards">
          <img src={b('tarjetas/tarjeta-frente.png')} alt="Tarjeta de Ápice, frente: logo sobre Noche alpina con curvas de nivel" width="1288" height="832" loading="lazy" />
          <img src={b('tarjetas/tarjeta-dorso.png')} alt="Tarjeta de Ápice, dorso: eslogan, isotipo y dirección web" width="1288" height="832" loading="lazy" />
        </div>
        <p class="note">85 × 55 mm con 3 mm de sangrado. <a href={b('tarjetas/tarjeta-apice-imprenta.pdf')} download>PDF para imprenta</a> · <a href={b('tarjetas/tarjeta-apice.html')}>HTML editable</a>. Para tarjetas personales, rellena nombre y cargo en <code>brand/datos.json</code> y ejecuta <code>npm run brand:render</code>.</p>

        <h3 class="mt">Firma de correo</h3>
        <img class="sig" src={b('email/firma-apice.png')} alt="Firma de correo de Ápice" width="560" height="140" loading="lazy" />
        <p class="note"><a href={b('email/firma-apice.html')}>Abrir la firma en HTML</a>: selecciona todo, copia y pégalo en la configuración de firma de Gmail, Outlook o Apple Mail.</p>

        <h3 class="mt">Presentación y documento</h3>
        <div class="slides">
          {[1, 2, 3, 4, 5].map((n) => <img src={b(`plantillas/diapositiva-${n}.png`)} alt={`Plantilla de presentación, diapositiva ${n}`} width="1920" height="1080" loading="lazy" />)}
          <img src={b('plantillas/documento-apice.png')} alt="Plantilla de documento A4 con membrete" width="794" height="1123" loading="lazy" class="doc" />
        </div>
        <p class="note"><a href={b('plantillas/presentacion-apice.pdf')} download>Presentación PDF</a> · <a href={b('plantillas/presentacion-apice.html')}>HTML editable</a> · <a href={b('plantillas/documento-apice.pdf')} download>Documento PDF</a> · <a href={b('plantillas/documento-apice.html')}>HTML editable</a></p>

        <h3 class="mt">Redes sociales</h3>
        <div class="social">
          <img src={b('redes/post-cuadrado-1080.png')} alt="Publicación cuadrada" width="1080" height="1080" loading="lazy" />
          <img src={b('redes/post-vertical-1080x1350.png')} alt="Publicación vertical" width="1080" height="1350" loading="lazy" />
          <img src={b('redes/historia-1080x1920.png')} alt="Historia vertical" width="1080" height="1920" loading="lazy" />
          <img class="wide" src={b('redes/banner-linkedin-1584x396.png')} alt="Banner de LinkedIn" width="1584" height="396" loading="lazy" />
          <img class="wide" src={b('redes/cabecera-x-1500x500.png')} alt="Cabecera de X" width="1500" height="500" loading="lazy" />
        </div>

        <h3 class="mt">Favicon e imágenes para compartir</h3>
        <div class="og">
          <div class="favs"><img src={asset('favicon.svg')} alt="Favicon" width="64" height="64" /><img src={asset('apple-touch-icon.png')} alt="Icono de app" width="90" height="90" /></div>
          <img src={asset('og/home-es.png')} alt="Imagen para compartir la portada" width="1200" height="630" loading="lazy" />
          <img src={asset('og/product-muevelo-es.png')} alt="Imagen para compartir Muévelo" width="1200" height="630" loading="lazy" />
        </div>
        <p class="note">Las imágenes para compartir se generan solas en cada compilación, una por página y producto.</p>
      </section>

      <!-- 12 Descargas -->
      <section id="descargas" class="bsec">
        <p class="eyebrow">12 · Descargas</p>
        <h2>Archivos</h2>
        <ul class="dl">
          <li><a href={b('logo/apice-horizontal.svg')} download>Logo horizontal (SVG)</a></li>
          <li><a href={b('logo/apice-vertical.svg')} download>Logo vertical (SVG)</a></li>
